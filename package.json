{
  "name": "plataforma-espectroscopia",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "servir": "python3 tools/servir.py 8080",
    "test:regras": "firebase emulators:exec --only firestore --project demo-uvvis \"node --test tests/regras.spec.mjs\"",
    "emulador": "firebase emulators:start --only firestore,auth --project demo-uvvis"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.14.1",
    "firebase-tools": "^13.35.1"
  }
}
