rules_version = '2';
// Regras da plataforma de espectroscopia.
// Aluno: login anônimo; só cria registros próprios, nunca lê dados de outros.
// Professor: login Google com o e-mail abaixo (o mesmo de public/js/config.js).
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function isProf() {
      return logado()
        && request.auth.token.get("email", "") == "boniek@ufg.br"
        && request.auth.token.get("email_verified", false) == true;
    }
    function agora(campo) { return request.resource.data[campo] == request.time; }
    function soCampos(lista) { return request.resource.data.keys().hasOnly(lista); }
    function texto(v, max) { return v is string && v.size() <= max; }
    function membroOk(l, i) { return l.size() <= i || (l[i] is map && texto(l[i].nome, 80) && texto(l[i].matricula, 12)); }
    // até 6 integrantes, cada um {nome, matricula} como texto
    function membrosOk(l) {
      return l is list && l.size() <= 6 && membroOk(l, 0) && membroOk(l, 1) && membroOk(l, 2)
        && membroOk(l, 3) && membroOk(l, 4) && membroOk(l, 5);
    }

    // alunos/{turma}_{matricula}
    match /alunos/{id} {
      allow read: if isProf();
      allow create: if logado()
        && id == request.resource.data.turma + "_" + request.resource.data.matricula
        && soCampos(["nome", "matricula", "turma", "avatar", "primeiroAcesso", "ultimoAcesso"])
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 80
        && agora("primeiroAcesso") && agora("ultimoAcesso");
      // troca de celular: outro uid pode atualizar nome e último acesso
      allow update: if logado()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["nome", "avatar", "ultimoAcesso"])
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 80
        && agora("ultimoAcesso");
      allow write: if isProf();
    }

    match /acessos/{id} {
      allow read: if isProf();
      allow create: if logado()
        && soCampos(["turma", "matricula", "pagina", "uid", "quando"])
        && request.resource.data.uid == request.auth.uid
        && agora("quando");
    }

    match /respostas/{id} {
      allow read: if isProf();
      allow create: if logado()
        && soCampos(["tipo", "modulo", "turma", "atividade", "questaoId", "bloco", "correta", "tentativa", "equipe", "membros", "uid", "quando"])
        && request.resource.data.tipo in ["casa", "grupo"]
        && (!("modulo" in request.resource.data) || request.resource.data.modulo in ["uvvis", "iv"])
        && request.resource.data.correta is bool
        && request.resource.data.tentativa is int && request.resource.data.tentativa >= 1
        && membrosOk(request.resource.data.membros) && request.resource.data.membros.size() <= 4
        && request.resource.data.uid == request.auth.uid
        && agora("quando");
    }

    // sala atual de cada turma: o QR code fixo do slide leva o aluno ao quiz aberto
    match /turmas/{turma} {
      allow get: if logado();
      allow write: if isProf();

      // personagem escolhido no registro: um dono por símbolo na turma.
      // "dono" é um código derivado da matrícula (não a matrícula): o mesmo aluno pode reassumir de outro celular.
      match /avatares/{id} {
        allow read: if logado();
        allow create: if logado() && soCampos(["dono", "uid"]) && texto(request.resource.data.dono, 64)
          && request.resource.data.uid == request.auth.uid;
        allow update: if logado() && soCampos(["dono", "uid"]) && request.resource.data.dono == resource.data.dono
          && request.resource.data.uid == request.auth.uid;
        allow delete: if isProf() || (logado() && resource.data.uid == request.auth.uid);
      }
    }

    // gabarito da competição: só o professor
    match /bancos/{modulo} {
      allow read, write: if isProf();
    }

    match /salas/{codigo} {
      allow get: if logado();   // aluno lê a sala pelo código, mas não lista as salas
      allow list: if isProf();
      allow write: if isProf();

      function sala() { return get(/databases/$(database)/documents/salas/$(codigo)).data; }

      match /jogadores/{uid} {
        allow read: if isProf() || (logado() && request.auth.uid == uid);
        // no quiz em equipes, "nome" é o nome da equipe e "membros" lista os integrantes
        allow create: if logado() && uid == request.auth.uid
          && soCampos(["nome", "matricula", "membros", "avatar", "entrouEm"])
          && texto(request.resource.data.nome, 80) && texto(request.resource.data.matricula, 12)
          && (!("avatar" in request.resource.data) || texto(request.resource.data.avatar, 8))
          && (!("membros" in request.resource.data) || membrosOk(request.resource.data.membros))
          && agora("entrouEm");
        allow write: if isProf();
      }

      match /respostas/{id} {
        allow read: if isProf();
        allow create: if logado()
          && id == string(request.resource.data.indice) + "_" + request.auth.uid
          && soCampos(["uid", "indice", "alternativa", "quando"])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.alternativa is int
          && request.resource.data.alternativa >= 0 && request.resource.data.alternativa <= 4
          && sala().estado == "pergunta"
          && request.resource.data.indice == sala().indice
          // prazo pelo relógio do servidor: abertura + tempo da pergunta + 1,5 s de tolerância
          && request.time < sala().abertaEm + duration.value(sala().limiteMs + 1500, "ms")
          && agora("quando");
        allow delete: if isProf();
      }

      match /placar/{uid} {
        allow read: if logado();
        allow write: if isProf();
      }
    }
  }
}
